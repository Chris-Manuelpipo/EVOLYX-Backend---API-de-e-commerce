# Copier en .env (Vercel / valeurs partagées) et .env.local (local).
# En local, .env.local est chargé en premier et surcharge .env.
# .env et .env.local sont gitignorés.

NODE_ENV=development
PORT=5000

# PostgreSQL — un des deux modes (DATABASE_URL prioritaire s'il est non vide)
# DB_URL est un alias de DATABASE_URL si DATABASE_URL est vide et que DB_* n'est pas complet.

# Mode A — URL unique (Render / prod)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/evolyx

# Mode B — variables séparées (local). Utilisé si DATABASE_URL est absent ou vide.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=evolyx

# SSL: auto (off sur localhost, on ailleurs). Forcer avec true|false
DATABASE_SSL=false

# JWT — min. 32 caractères aléatoires en production
JWT_SECRET=change-me-to-a-long-random-string-please

# Secret optionnel pour GET /api/boot-check en production
# BOOT_CHECK_SECRET=

# URL boutique (lien de suivi WhatsApp)
SHOP_URL=https://shop.evolyx.cm

# SSL Postgres : true pour vérifier le certificat (sinon false / défaut pour Neon pooler)
# DATABASE_SSL_STRICT=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Origines CORS supplémentaires, séparées par des virgules
# (shop.evolyx.cm, evolyx.cm, localhost:8080 et les autres localhost sont déjà inclus par défaut)
CORS_ORIGINS=https://shop.evolyx.cm,https://evolyx.cm,https://www.evolyx.cm

# WhatsApp (sans + ni espaces)
WHATSAPP_NUMBER=237654804907

# Compte admin initial (create-admin.js / db:seed) — ne jamais committer les valeurs
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ROLE=super_admin

# 2FA admin : non implémenté (voir docs/PRODUCTION.md)
# ADMIN_TOTP_SECRET=
